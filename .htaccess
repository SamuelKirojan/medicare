# Security Configuration for Canteen Application
# Place this in the root directory (c:\xampp\htdocs\Canteen\)

# Redirect all requests to public directory
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "^\.">
    # Apache 2.4+
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    # Apache 2.2
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>


# Custom Error Pages
ErrorDocument 403 /public/index.php?r=error/error403
ErrorDocument 404 /public/index.php?r=error/error404
ErrorDocument 500 /public/index.php?r=error/error500